# service
EMAIL_SERVICE_PORT=3060
NODE_ENV=development
LOG_LEVEL=info
RUN_API=true
RUN_CONSUMER=true

# # redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_EMAIL=internal

# Email Provider
MAILJET_API_KEY=REPLACE_ME
MAILJET_API_SECRET=REPLACE_ME
EMAIL_DEFAULT_FROM=noreply@email-service.local
EMAIL_MAX_RETRIES=5

EMAIL_SERVICE_AUTH_TOKEN=change-me-email-service-token
ENABLE_REMOTE_SHEET_URL=false
# SHEET_URL_ALLOWLIST=https://docs.google.com/*
